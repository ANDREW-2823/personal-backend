# ---------------------------------------------------------------------------
# JARVIS backend environment (development)
# Copy to .env and adjust. This file is never committed.
# ---------------------------------------------------------------------------

DATABASE_URL=postgresql://postgres:Glad@localhost:5432/Jarvis

JARVIS_API_HOST=127.0.0.1
JARVIS_API_PORT=8756
# Electron generates a random token per installation and passes it in.
# For direct `uvicorn` development, set the same value here.
JARVIS_API_TOKEN=jarvis-local-dev-token
JARVIS_ENVIRONMENT=development
JARVIS_ENV=development

JARVIS_DEFAULT_TIMEZONE=Asia/Kolkata
JARVIS_LOG_LEVEL=INFO
JARVIS_SCHEDULER_ENABLED=true

# The Vite dev origins plus "null" for the packaged renderer loaded from
# file://. Keep this narrow; the API also requires the per-install token.
JARVIS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,null

# AI provider: mock | openai | anthropic | ollama
# Leave empty/mock to run the fully functional offline assistant.
AI_PROVIDER=mock
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
JARVIS_OLLAMA_BASE_URL=http://127.0.0.1:11434

# ---------------------------------------------------------------------------
# Voice pipeline
# ---------------------------------------------------------------------------
# faster-whisper downloads the model on first use and caches it locally.
JARVIS_WHISPER_MODEL=base.en
JARVIS_WHISPER_DEVICE=cpu
JARVIS_WHISPER_COMPUTE_TYPE=int8
JARVIS_WHISPER_LANGUAGE=en
# edge-tts voice. The HUD can override this per request in Settings.
JARVIS_TTS_VOICE=en-GB-RyanNeural
JARVIS_TTS_LANGUAGE=en-GB
# Local openWakeWord model (downloaded into the virtualenv).
JARVIS_WAKE_MODEL=hey_jarvis
JARVIS_WAKE_THRESHOLD=0.6
JARVIS_WAKE_COOLDOWN_SECONDS=2.0
JARVIS_MAX_AUDIO_BYTES=26214400

# ---------------------------------------------------------------------------
# Spotify (https://developer.spotify.com/dashboard)
# ---------------------------------------------------------------------------
# Add the exact redirect URI below to the Spotify app. Client credentials are
# read only by the backend and are never sent to the renderer.
JARVIS_SPOTIFY_CLIENT_ID=
# Optional for the PKCE flow; keep it secret if supplied.
JARVIS_SPOTIFY_CLIENT_SECRET=
JARVIS_SPOTIFY_REDIRECT_URI=http://127.0.0.1:8756/api/v1/spotify/callback

# ---------------------------------------------------------------------------
# Local secret storage
# ---------------------------------------------------------------------------
# Optional Fernet source secret. If empty, backend/.data/secrets.key is created
# once with user-only permissions. Either way, Spotify tokens are encrypted.
JARVIS_SECRETS_KEY=

